{"scope":"ui.windows","schemaId":"ui.windows@2","version":2,"mcpDelete":false,"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"UI trigger rules","description":"Universal SDK triggers (client-sdk core triggers.ts): a source (bus event or ui-kit element) plus conditions and limits runs module actions; windows go through the SDK window queue.","x-configs-mode":"single","x-configs-fetch":"all","type":"object","additionalProperties":false,"required":["triggers"],"properties":{"triggers":{"type":"array","maxItems":256,"x-configs-unique-by":"id","items":{"type":"object","additionalProperties":false,"required":["id","on","do"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},"on":{"description":"Exactly one source: a bus event by name or a ui-kit element id.","oneOf":[{"type":"object","additionalProperties":false,"required":["event"],"properties":{"event":{"type":"string","maxLength":128,"pattern":"^([a-z][a-z0-9]*(-[a-z0-9]+)*:[a-z][a-z0-9]*(-[a-z0-9]+)*:[a-z][a-z0-9]*(-[a-z0-9]+)*|auth:playerChanged|time:offsetChanged|sdk:realtime:(status|transport):changed|realtime:[a-z][a-z0-9_]*(\\.[a-z0-9_:-]+)+)$","not":{"enum":["ui:element:action","sdk:ui:trigger-failed"]}}}},{"type":"object","additionalProperties":false,"required":["element"],"properties":{"element":{"type":"string","maxLength":128,"pattern":"^[a-z][a-z0-9-]*([.:][a-z][a-z0-9-]*)*$"}}}]},"payload":{"description":"Condition on the event payload (filter syntax; plain keys are payload fields).","type":"object","maxProperties":32,"additionalProperties":true,"x-configs-payload-filter":true},"when":{"description":"Condition on the player (sdk.filters FilterExpr).","type":"object","maxProperties":32,"additionalProperties":true,"x-configs-filter":true},"priority":{"type":"number","minimum":-10000,"maximum":10000},"cooldownSec":{"type":"integer","minimum":0,"maximum":86400},"maxPerSession":{"type":"integer","minimum":0,"maximum":1000},"group":{"type":"string","pattern":"^[a-z][a-z0-9_.:-]{0,63}$"},"do":{"type":"array","minItems":1,"maxItems":16,"items":{"oneOf":[{"description":"Built-in placement action: asks the host placement port.","type":"object","additionalProperties":false,"required":["module","action","params"],"properties":{"module":{"const":"ui"},"action":{"const":"placement"},"params":{"type":"object","additionalProperties":false,"required":["placement"],"properties":{"placement":{"type":"string","pattern":"^[a-z][a-z0-9_]{1,47}$","x-configs-ref":{"scope":"iap.placements"}}}}}},{"description":"Action published by a module (effect or registered window).","type":"object","additionalProperties":false,"required":["module","action"],"properties":{"module":{"type":"string","maxLength":128,"pattern":"^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"},"action":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"params":{"type":"object","maxProperties":32,"additionalProperties":true}},"not":{"required":["module","action"],"properties":{"module":{"const":"ui"},"action":{"const":"placement"}}}}]}}}}}},"$id":"urn:manyplay:schema:ui.windows:v2"}}
