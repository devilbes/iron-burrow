{
  "id": "levels",
  "version": "1.0.0-rc.30",
  "kind": "service",
  "engines": {
    "core": "^1.0.0"
  },
  "targets": [
    "web",
    "cordova"
  ],
  "requires": {
    "progress": "^1.0.0"
  },
  "permissions": [
    "storage"
  ],
  "entry": "sdk-runtime/levels.js",
  "load": "eager",
  "settings": {
    "schemaVersion": 1,
    "fields": [
      {
        "ref": "availability"
      },
      {
        "key": "chunkSize",
        "type": "integer",
        "min": 1,
        "max": 200,
        "default": 10,
        "label": {
          "ru": "Размер порции уровней",
          "en": "Level chunk size"
        }
      },
      {
        "key": "cacheMaxBytes",
        "type": "integer",
        "min": 81920,
        "max": 16777216,
        "default": 2097152,
        "label": {
          "ru": "Лимит кэша уровней (байты)",
          "en": "Level cache byte limit"
        }
      },
      {
        "key": "prefetchDepth",
        "type": "integer",
        "min": 0,
        "max": 4,
        "default": 1,
        "label": {
          "ru": "Глубина префетча",
          "en": "Prefetch depth"
        }
      }
    ]
  },
  "events": {
    "emits": [
      "levels:range:loaded"
    ],
    "listens": [
      "configs:snapshot:updated",
      "sdk:context:changed"
    ]
  },
  "title": {
    "ru": "Прогресс и награды",
    "en": "Progress"
  },
  "description": {
    "ru": "Прогресс и награды для игры на ManyPlay.",
    "en": "ManyPlay client progress actions and verified level results."
  },
  "llmDescription": "ManyPlay client progress actions and verified level results. Select mod-progress when the game needs this SDK capability. Read the linked module documentation for methods and events.",
  "selection": "optional",
  "status": "ready",
  "preview": {
    "icon": "catalog/icon.png",
    "media": [],
    "mock": {
      "badge": {
        "kind": "dot"
      },
      "value": 1
    }
  },
  "docs": [
    {
      "title": {
        "ru": "Документация",
        "en": "Documentation"
      },
      "uri": "https://github.com/manygamescorp/client-sdk/tree/main/packages/mod-progress"
    }
  ],
  "group": "progression",
  "tags": [
    "levels",
    "progress"
  ],
  "package": "@manygamescorp/mod-progress",
  "files": {
    "scripts": [
      "client.js",
      "levels-cache.js",
      "levels-settings.js",
      "levels-validation.js",
      "levels.js",
      "mechanic-attempts.js",
      "mechanic-curve.js",
      "mechanic-outcome.js",
      "mechanic-settings.js",
      "mechanic-types.js",
      "mechanic-validation.js",
      "mechanic.js",
      "progress-state.js",
      "progress-types.js",
      "progress.js",
      "sdk-runtime/levels.js",
      "sdk-runtime/progress.js",
      "settings-text.js",
      "version.js",
      "windows.js"
    ],
    "styles": [],
    "assets": [
      "catalog/icon.png",
      "sdk-runtime/levels.json",
      "sdk-runtime/progress.json",
      "ui.json"
    ]
  }
}
