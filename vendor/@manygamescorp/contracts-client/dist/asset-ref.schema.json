{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "AssetRef",
    "type": "string",
    "format": "asset-ref",
    "maxLength": 2048,
    "pattern": "^(?:skin:[a-z0-9][a-z0-9_-]{0,63}|asset:(?!\\.{1,2}(?:/|$))(?![a-zA-Z0-9_./-]*/\\.{0,2}(?:/|$))[a-zA-Z0-9_.-][a-zA-Z0-9_./-]*|https://[^\\s\\\\@/?#]+|https://[^\\s\\\\@/?#]+[/?#][^\\s\\\\]*)$"
}
