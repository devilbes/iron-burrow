{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SDK module manifest actions",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "callable"
    ],
    "properties": {
        "callable": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "params": {
                        "type": [
                            "object",
                            "boolean"
                        ]
                    },
                    "result": {
                        "anyOf": [
                            {
                                "type": [
                                    "object",
                                    "boolean"
                                ]
                            },
                            {
                                "const": "mechanic-outcome@1"
                            }
                        ]
                    }
                }
            }
        }
    }
}
