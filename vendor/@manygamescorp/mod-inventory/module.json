{
  "id": "inventory",
  "version": "1.0.0-rc.30",
  "entry": "dist/sdk-runtime/inventory.js",
  "targets": [
    "cordova",
    "web"
  ],
  "title": {
    "ru": "Инвентарь",
    "en": "Inventory"
  },
  "description": {
    "ru": "Инвентарь для игры на ManyPlay.",
    "en": "ManyPlay player inventory projection and exchange by server rule."
  },
  "llmDescription": "ManyPlay player inventory projection and exchange by server rule. Select mod-inventory when the game needs this SDK capability. Read the linked module documentation for methods and events.",
  "selection": "optional",
  "status": "ready",
  "preview": {
    "icon": "dist/catalog/icon.png",
    "media": [],
    "mock": {
      "badge": {
        "kind": "dot"
      },
      "value": 1
    }
  },
  "docs": [
    {
      "title": {
        "ru": "Документация",
        "en": "Documentation"
      },
      "uri": "https://github.com/manygamescorp/client-sdk/tree/main/packages/mod-inventory"
    }
  ],
  "settings": {
    "schemaVersion": 1,
    "fields": [
      {
        "ref": "availability"
      }
    ]
  },
  "group": "economy",
  "tags": [
    "items",
    "inventory"
  ],
  "load": "eager",
  "ui": {
    "slots": [
      {
        "id": "entry",
        "zone": "hud",
        "contexts": [
          "main"
        ],
        "order": 30,
        "fallback": [],
        "features": [
          "badge",
          "timer",
          "value"
        ],
        "does": {
          "ru": "Рюкзак",
          "en": "Inventory"
        }
      },
      {
        "id": "counters",
        "zone": "topbar",
        "contexts": [
          "main"
        ],
        "order": 10,
        "features": [
          "value"
        ],
        "does": {
          "ru": "Счётчики",
          "en": "Counters"
        }
      }
    ]
  },
  "files": {
    "scripts": [
      "dist/gen/inventory.js",
      "dist/inventory.js",
      "dist/sdk-runtime/inventory.js",
      "dist/version.js"
    ],
    "styles": [],
    "assets": [
      "dist/catalog/icon.png",
      "dist/contracts/inventory.client.json",
      "dist/contracts/sources.json",
      "dist/sdk-runtime/inventory.json",
      "dist/ui.json"
    ]
  }
}
