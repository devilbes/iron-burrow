{
  "id": "iap",
  "version": "1.0.0-rc.30",
  "entry": "dist/sdk-runtime/iap.js",
  "targets": [
    "cordova",
    "web"
  ],
  "title": {
    "ru": "Покупки",
    "en": "Iap"
  },
  "description": {
    "ru": "Покупки для игры на ManyPlay.",
    "en": "ManyPlay in-app purchases: offers from configs iap.*, orders of the iap service, StoreAdapter port and the fake store of test/dev builds."
  },
  "llmDescription": "ManyPlay in-app purchases: offers from configs iap.*, orders of the iap service, StoreAdapter port and the fake store of test/dev builds. Select mod-iap when the game needs this SDK capability. Read the linked module documentation for methods and events.",
  "selection": "optional",
  "status": "ready",
  "preview": {
    "icon": "dist/catalog/icon.png",
    "media": [],
    "mock": {
      "badge": {
        "kind": "dot"
      },
      "value": 1
    }
  },
  "docs": [
    {
      "title": {
        "ru": "Документация",
        "en": "Documentation"
      },
      "uri": "https://github.com/manygamescorp/client-sdk/tree/main/packages/mod-iap"
    }
  ],
  "settings": {
    "schemaVersion": 1,
    "fields": [
      {
        "ref": "availability"
      }
    ]
  },
  "group": "monetization",
  "tags": [
    "purchases",
    "shop"
  ],
  "load": "eager",
  "ui": {
    "slots": [
      {
        "id": "entry",
        "zone": "hud",
        "contexts": [
          "main"
        ],
        "order": 50,
        "fallback": [],
        "features": [
          "badge",
          "timer",
          "value"
        ],
        "does": {
          "ru": "Магазин",
          "en": "Shop"
        }
      }
    ]
  },
  "files": {
    "scripts": [
      "dist/catalog.js",
      "dist/contract.js",
      "dist/fake-module.js",
      "dist/fake-store.js",
      "dist/iap.js",
      "dist/public-iap.js",
      "dist/redirect-store.js",
      "dist/sdk-runtime/iap.js",
      "dist/sdk-runtime/store-fake.js",
      "dist/store-loader.js",
      "dist/store-prices.js",
      "dist/store-registration.js",
      "dist/store.js",
      "dist/version.js"
    ],
    "styles": [],
    "assets": [
      "dist/catalog/icon.png",
      "dist/sdk-runtime/iap.json",
      "dist/sdk-runtime/store-fake.json",
      "dist/ui.json"
    ]
  }
}
