{
  "id": "ui-kit",
  "selection": "required",
  "version": "1.0.0-rc.30",
  "kind": "ui",
  "engines": {
    "core": "^1.0.0"
  },
  "targets": [
    "web",
    "cordova"
  ],
  "settings": {
    "schemaVersion": 1,
    "fields": [
      {
        "key": "skin",
        "type": "enum",
        "label": {
          "ru": "Скин",
          "en": "Skin"
        },
        "options": [
          {
            "value": "manyplay",
            "label": {
              "ru": "manyplay",
              "en": "manyplay"
            }
          },
          {
            "value": "default",
            "label": {
              "ru": "default",
              "en": "default"
            }
          }
        ],
        "default": "manyplay"
      },
      {
        "key": "topbarMain",
        "type": "boolean",
        "label": {
          "ru": "Топ-бар главного экрана",
          "en": "Main top bar"
        },
        "default": true
      },
      {
        "key": "topbarCore",
        "type": "boolean",
        "label": {
          "ru": "Топ-бар механики",
          "en": "Core top bar"
        },
        "default": true
      },
      {
        "key": "hud",
        "type": "boolean",
        "label": {
          "ru": "Боковые иконки",
          "en": "HUD"
        },
        "default": true
      },
      {
        "key": "bottomMenu",
        "type": "boolean",
        "label": {
          "ru": "Нижнее меню",
          "en": "Bottom menu"
        },
        "default": true
      },
      {
        "key": "windowQueue",
        "type": "boolean",
        "label": {
          "ru": "Автоматические окна",
          "en": "Automatic windows"
        },
        "default": true
      }
    ]
  },
  "permissions": [
    "windows"
  ],
  "entry": "sdk-runtime/ui-kit.js",
  "load": "eager",
  "provides": [
    "ui.slots@1",
    "topbar.registry@1",
    "hud.registry@1",
    "bottommenu.registry@1",
    "profile.presentation@1"
  ],
  "events": {
    "emits": [
      "hud:layout:ignored"
    ],
    "listens": [
      "configs:snapshot:updated",
      "l10n:locale:changed",
      "l10n:strings:updated"
    ]
  },
  "title": {
    "ru": "UI Kit",
    "en": "UI Kit"
  },
  "description": {
    "ru": "Нейтральные компоненты SDK и окна ManyPlay ID.",
    "en": "Neutral UI components and window contracts with a fixed ManyPlay ID presentation."
  },
  "llmDescription": "Neutral UI components and window contracts with a fixed ManyPlay ID presentation. Game presentation is selected separately with a skin bundle.",
  "status": "ready",
  "preview": {
    "icon": "catalog/icon.png",
    "media": []
  },
  "docs": [
    {
      "title": {
        "ru": "Документация",
        "en": "Documentation"
      },
      "uri": "https://github.com/manygamescorp/client-sdk/tree/main/packages/ui-kit"
