{
  "name": "@manygamescorp/mod-profile-pack",
  "version": "1.0.0-rc.30",
  "description": "Select package profile-pack for player KV, game state and profile UI; headless profile belongs to core.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./kv": {
      "types": "./dist/kv.d.ts",
      "default": "./dist/kv.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "default": "./dist/state.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./package.json": "./package.json",
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "default": "./dist/presentation.js"
    }
  }
}
