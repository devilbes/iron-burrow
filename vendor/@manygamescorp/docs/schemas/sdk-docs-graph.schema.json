{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Next-LTS SDK documentation exact graph (producer fixture; not a live MCP contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pin"
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "vendorSha256",
        "docsSha256",
        "requires"
      ],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^@manygamescorp/[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "vendorSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "docsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requires": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/pin/properties/package"
          },
          "additionalProperties": {
            "$ref": "#/$defs/pin/properties/version"
          }
        }
      }
    }
  }
}
