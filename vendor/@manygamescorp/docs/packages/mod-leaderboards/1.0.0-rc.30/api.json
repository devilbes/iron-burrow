{
  "schemaVersion": 1,
  "package": "@manygamescorp/mod-leaderboards",
  "version": "1.0.0-rc.30",
  "requires": {
    "@manygamescorp/core": "1.0.0-rc.30"
  },
  "modules": [
    {
      "name": "leaderboards",
      "package": "@manygamescorp/mod-leaderboards",
      "description": "Leaderboards: read ranked boards, ranks and neighbouring entries, and submit scores when client submission is enabled.",
      "methods": [
        {
          "name": "around",
          "description": "Fetches the entries around the current player on a board.",
          "kind": "method",
          "params": {
            "type": "object",
            "x-positional": true,
            "properties": {
              "leaderboardKey": {
                "description": "Leaderboard key from the application configuration.",
                "type": "string"
              },
              "options": {
                "description": "Window size: `radius`, or `above`/`below` (0-50 entries each; not both forms).",
                "type": "object",
                "properties": {
                  "above": {
                    "description": "Entries to include above the player, 0-50; cannot be combined with `radius`.",
                    "type": "number"
                  },
                  "below": {
                    "description": "Entries to include below the player, 0-50; cannot be combined with `radius`.",
                    "type": "number"
                  },
                  "radius": {
                    "description": "Entries on each side of the player, 0-50; use instead of `above`/`below`.",
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "leaderboardKey"
            ]
          },
          "returns": {
            "description": "The player's rank and score plus the surrounding entries.",
            "type": "object",
            "properties": {
              "entries": {
                "description": "Entries surrounding the player, ordered by rank.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "gid": {
                      "description": "Global player ID.",
                      "type": "number"
                    },
                    "rank": {
                      "description": "1-based position on the board.",
                      "type": "number"
                    },
                    "score": {
                      "description": "Player score on the board.",
                      "type": "number"
                    },
                    "profile": {
                      "description": "Public profile of the player; present when the profile module is available.",
                      "type": "object",
                      "properties": {
                        "gid": {
                          "description": "Global player ID.",
                          "type": "number"
                        },
                        "name": {
                          "description": "Player display name.",
                          "type": "string"
                        },
                        "avatar": {
                          "description": "Avatar identifier, or `null` when none is set.",
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "string"
                            }
                          ]
                        },
                        "level": {
                          "description": "Player level.",
                          "type": "number"
                        }
                      },
                      "required": [
                        "gid",
                        "name",
                        "avatar",
                        "level"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "gid",
                    "rank",
                    "score"
                  ],
                  "additionalProperties": false
                }
              },
              "boardId": {
                "description": "Board identifier (UUID string).",
                "type": "string"
              },
              "gid": {
                "description": "Global player ID the rank belongs to.",
                "type": "number"
              },
              "rank": {
                "description": "1-based rank, or `null` when the player has no entry.",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "score": {
                "description": "Score, or `null` when the player has no entry.",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            },
            "required": [
              "entries",
              "boardId",
              "gid",
              "rank",
              "score"
            ],
            "additionalProperties": false
          },
          "errors": [
            {
              "code": "VALIDATION_FAILED",
              "hint": "leaderboardKey or window options are invalid."
            },
            {
              "code": "MODULE_NOT_ACTIVE",
              "hint": "The module is stopped."
            }
          ],
          "example": "const near = await sdk.leaderboards.around('ranked', { radius: 3 });\nconsole.log(near.rank, near.entries.length);"
        },
        {
