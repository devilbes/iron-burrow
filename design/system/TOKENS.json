{
  "version": 1,
  "id": "iron-burrow",
  "units": "CSS px at 1x",
  "colors": {
    "slate_abyss": "#0A1118",
    "slate_deep": "#121E29",
    "slate_blue": "#1E2E3D",
    "slate_mid": "#2F4558",
    "steel_teal": "#2F7D86",
    "steel_teal_light": "#6FC2C4",
    "steel_frost": "#CFE6E8",
    "rivet_iron": "#5D6B75",
    "magma_orange": "#FF6A1A",
    "magma_hot": "#FFB23F",
    "magma_deep": "#B8320C",
    "core_amber": "#FFC845",
    "core_white": "#FFF4D6",
    "acid_green": "#9BFF2E",
    "acid_green_dark": "#3F9E12",
    "rust_shell": "#7A4A2E",
    "rust_light": "#B5713F",
    "clay_brick": "#A65A3A",
    "clay_brick_light": "#D08A5E",
    "alarm_red": "#FF3B3B",
    "text_main": "#F2F6F7",
    "text_dim": "#8FA3B0"
  },
  "semantic": {
    "background": "#121E29",
    "surface": "#1E2E3D",
    "surfaceRaised": "#2F4558",
    "primary": "#FF6A1A",
    "primaryText": "#0A1118",
    "secondary": "#2F7D86",
    "reward": "#FFC845",
    "enemy": "#9BFF2E",
    "danger": "#FF3B3B",
    "text": "#F2F6F7",
    "textMuted": "#8FA3B0",
    "currency": null
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "shape": {
    "cornerCut": 8,
    "largeCornerCut": 16,
    "innerRadius": 4,
    "outline": 1,
    "bevel": 2
  },
  "typography": {
    "families": {
      "display": "Russo One",
      "ui": "Exo 2",
      "body": "Exo 2"
    },
    "weights": {
      "display": 400,
      "body": 500,
      "strong": 700
    },
    "sizes": [
      12,
      14,
      16,
      20,
      24,
      32,
      40
    ],
    "roles": {
      "caption": 14,
      "body": 16,
      "value": 24,
      "title": 32
    },
    "lineHeight": {
      "body": 1.4,
      "display": 1.1
    },
    "scoreNumerals": "tabular-nums",
    "sources": [
      {
        "package": "@fontsource/russo-one",
        "license": "OFL-1.1",
        "subset": "latin",
        "weights": [
          400
        ]
      },
      {
        "package": "@fontsource/exo-2",
        "license": "OFL-1.1",
        "subset": "latin",
        "weights": [
          500,
          700
        ]
      }
    ],
    "delivery": "Theme step installs pinned fontsource packages and ships local WOFF2 plus licenses; no font payload in foundation."
  },
  "shadows": {
    "raised": {
      "x": 0,
      "y": 2,
      "blur": 4,
      "color": "#0A1118",
      "opacity": 0.24
    },
    "floating": {
      "x": 0,
      "y": 6,
      "blur": 12,
      "color": "#0A1118",
      "opacity": 0.32
    },
    "modal": {
      "x": 0,
      "y": 12,
      "blur": 24,
      "color": "#0A1118",
      "opacity": 0.4
    }
  },
  "interaction": {
    "touchTargetMin": 48,
    "pressedOffset": 2,
    "focusWidth": 2,
    "focusOffset": 2
  },
  "integration": {
    "method": "Game-owned defineSkin/useSkin extension where supported by installed UI Kit; use its actual exported token contract, without importing skin-manyplay.",
    "fontRoles": {
      "--mp-font-display": "Russo One",
      "--mp-font-ui": "Exo 2",
      "--mp-font-body": "Exo 2"
    },
    "productionSkin": "Future steps supply raster UI assets from GDD 21; foundation is not a complete skin."
  }
}
