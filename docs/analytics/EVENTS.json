  "funnels": [
    {
      "id": "ftue",
      "title": "First session to first clear",
      "steps": [
        "session_start",
        "tutorial_step",
        "tutorial_done",
        "level_start",
        "level_complete"
      ]
    },
    {
      "id": "core_loop",
      "title": "Attempt, defeat and continue",
      "steps": [
        "level_start",
        "level_fail",
        "continue_used",
        "stage_end"
      ]
    },
    {
      "id": "purchase",
      "title": "Offer to paid order",
      "steps": [
        "offer_shown",
        "offer_click",
        "purchase_start",
        "purchase_result",
        "offer_purchase",
        {
          "event": "iap",
          "required": false
        }
      ]
    },
    {
      "id": "campaign",
      "title": "Campaign depth",
      "steps": [
        "level_start",
        "level_complete",
        "stage_end"
      ]
    }
  ],
  "kpi": [
    {
      "id": "d1_retention",
      "formula": "players with session_start on day 1 after first session_start / players with first session_start",
      "events": [
        "session_start"
      ],
      "targetRef": null
    },
    {
      "id": "d7_retention",
      "formula": "players with session_start on day 7 / players with first session_start",
      "events": [
        "session_start"
      ],
      "targetRef": null
    },
    {
      "id": "session_length",
      "formula": "median session_end.duration_s",
      "events": [
        "session_end"
      ],
      "targetRef": null
    },
    {
      "id": "tutorial_completion",
      "formula": "players with tutorial_done(skipped=false) / players with tutorial_step(step=1)",
      "events": [
        "tutorial_step",
        "tutorial_done"
      ],
      "targetRef": "QUALITY_TARGETS.kpi.tutorial_completion"
    },
    {
      "id": "tutorial_skip",
      "formula": "players with tutorial_done(skipped=true) / players with tutorial_step(step=1)",
      "events": [
        "tutorial_step",
        "tutorial_done"
      ],
      "targetRef": "QUALITY_TARGETS.kpi.tutorial_skip"
    },
    {
      "id": "stage_reach",
      "formula": "share of players with level_complete(level_set=campaign, level_n=5|10|30) among players with level_start",
      "events": [
        "level_start",
        "level_complete"
      ],
      "targetRef": null
    },
    {
      "id": "difficulty_curve",
      "formula": "per level_n: stage_end(result=clear) / stage_end attempts; median attempts to first clear",
      "events": [
        "stage_end"
      ],
      "targetRef": null
    },
    {
      "id": "continue_rate",
      "formula": "continue_used / level_fail(level_set, reason!=quit)",
      "events": [
        "continue_used",
        "level_fail"
      ],
      "targetRef": null
    },
    {
      "id": "d1_retention_proxy",
      "formula": "players with >=1 stage_end on day 1 after first session_start / players with first session_start (AB_PLAN guardrail)",
      "events": [
        "stage_end",
        "session_start"
      ],
      "targetRef": null
    },
    {
      "id": "payer_conversion",
      "formula": "players with purchase_result(result=success, product_id present, is_test=false) / players with session_start",
      "events": [
        "purchase_result",
        "session_start"
      ],
      "targetRef": null
    },
    {
      "id": "starter_share",
      "formula": "purchase_result(success, offer_id=starter_crate) / purchase_result(success, product_id present)",
      "events": [
        "purchase_result"
      ],
      "targetRef": null
    },
    {
      "id": "hull_pack_share",
      "formula": "purchase_result(success, offer_id=hull_pack) / purchase_result(success, product_id present)",
      "events": [
        "purchase_result"
      ],
      "targetRef": null
    },
    {
      "id": "offer_ctr",
      "formula": "offer_click / offer_shown per placement",
      "events": [
        "offer_shown",
        "offer_click"
      ],
      "targetRef": null
    },
    {
      "id": "revenue",
      "formula": "sum iap.price by currency_code, is_test=false",
      "events": [
        "iap"
      ],
      "targetRef": null
    },
    {
      "id": "economy_balance",
      "formula": "per item: sum item_earned.amount by source_type vs sum item_spent.amount by sink_id; resource_shortage per 100 attempts",
      "events": [
        "item_earned",
        "item_spent",
        "resource_shortage"
      ],
      "targetRef": null
    },
    {
      "id": "daily_engagement",
      "formula": "players with daily_claim / players with session_start per day; distribution of day",
      "events": [
        "daily_claim",
        "session_start"
      ],
      "targetRef": null
    },
    {
      "id": "siege_engagement",
      "formula": "players with level_start(level_set=siege) / players with siege_unlock; median stage_end.waves for siege",
      "events": [
        "siege_unlock",
        "level_start",
        "stage_end"
      ],
      "targetRef": null
    },
    {
      "id": "leaderboard_interest",
      "formula": "players with leaderboard_view / players with session_start",
      "events": [
        "leaderboard_view",
        "session_start"
      ],
      "targetRef": null
    },
    {
      "id": "reliability",
      "formula": "client_error per 100 sessions by area and code",
      "events": [
        "client_error",
        "session_start"
      ],
      "targetRef": null
    }
  ]
}
