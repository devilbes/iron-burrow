{
  "version": 1,
  "game": "iron-burrow",
  "sdkSchema": "core analytics.sendEvent(name: string, payload?: object) @manygamescorp/core 1.0.0-rc.30 (no telemetry module in sdk.modules.list rev 2; no event schema published)",
  "transport": "sdk.analytics.sendEvent only; no-op until the platform registers a provider; no own network, no third-party SDK",
  "baseSet": {
    "source": "skill analytics-taxonomy N0 (fact analytics.baseSet not delivered to this run)",
    "excluded": [
      {
        "name": "ad_shown",
        "why": "no ads in this flow"
      },
      {
        "name": "ad_reward",
        "why": "no ads in this flow"
      }
    ]
  },
  "envelope": {
    "name": "E25",
    "fields": [
      "appId",
      "gid",
      "sessionId",
      "ts",
      "platform",
      "appVersion",
      "abGroup",
      "holdout"
    ],
    "filledBy": "platform provider; the game never sends or computes these"
  },
  "naming": "snake_case, <object>_<action>; name <= 40 chars [a-z0-9_]; <= 25 params; values string|integer|number|boolean only (no objects/arrays); string <= 100 chars",
  "paramTypes": [
    "string",
    "integer",
    "number",
    "boolean"
  ],
  "pii": "none: no nickname, avatar, email, device ids or free text; identity only via the platform envelope (gid)",
  "ads": "none — the flow has no ads",
  "events": [
    {
      "name": "session_start",
      "base": "N0",
      "category": "session",
      "params": [
        {
          "name": "entry",
          "type": "string",
          "required": true,
          "enum": [
            "cold",
            "resume"
          ]
        }
      ],
      "trigger": "boot after sdk:core:ready and Lobby S02 rendered (cold); page visible again after >=30 s hidden (resume)",
      "funnels": [
        "ftue"
      ],
      "feeds": [
        "d1_retention",
        "d7_retention"
      ],
      "pii": false,
      "sampling": 1
    },
    {
      "name": "session_end",
      "base": "N0",
      "category": "session",
      "params": [
        {
          "name": "duration_s",
          "type": "number",
          "required": true,
          "min": 0
        }
      ],
      "trigger": "pagehide / visibilitychange hidden",
      "funnels": [],
      "feeds": [
        "session_length"
      ],
      "pii": false,
      "sampling": 1
    },
    {
      "name": "tutorial_step",
      "base": "N0",
      "category": "ftue",
