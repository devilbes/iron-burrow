        {
          "name": "step",
          "type": "integer",
          "required": true,
          "min": 1,
          "max": 6
        },
        {
          "name": "step_id",
          "type": "string",
          "required": true,
          "note": "tutorial step key t1..t6 (GDD 14 §2)"
        }
      ],
      "trigger": "tutorial hint step shown in stage 1 (S05)",
      "funnels": [
        "ftue"
      ],
      "feeds": [
        "tutorial_completion",
        "tutorial_skip"
      ],
      "pii": false,
      "sampling": 1
    },
    {
      "name": "level_start",
      "base": "N0",
      "category": "progression",
      "params": [
        {
          "name": "level_set",
          "type": "string",
          "required": true,
          "enum": [
            "campaign",
            "siege"
          ]
        },
        {
          "name": "level_n",
          "type": "integer",
          "required": true,
          "min": 1,
          "max": 30,
          "note": "stage number; 1 for siege"
        },
        {
          "name": "attempt",
          "type": "integer",
          "required": true,
          "min": 1
        }
      ],
      "trigger": "progress.beginAttempt resolved and the stage/siege run starts",
      "funnels": [
        "ftue",
        "core_loop"
      ],
      "feeds": [
        "stage_reach"
      ],
      "pii": false,
      "sampling": 1
    },
    {
      "name": "level_complete",
      "base": "N0",
      "category": "progression",
      "params": [
        {
          "name": "level_set",
          "type": "string",
          "required": true,
          "enum": [
            "campaign",
            "siege"
          ]
        },
        {
          "name": "level_n",
          "type": "integer",
          "required": true,
          "min": 1,
          "max": 30,
          "note": "stage number; 1 for siege"
        },
        {
          "name": "score",
          "type": "integer",
          "required": true,
          "min": 0
        },
        {
          "name": "stars",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 3
        },
        {
          "name": "duration_s",
          "type": "number",
          "required": true,
          "min": 0
        }
      ],
      "trigger": "progress.levelEnd ACK for a cleared campaign stage (stars and score from the server)",
      "funnels": [
