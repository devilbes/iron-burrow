{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "outDir": "dist/app",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/*.ts", "src/modules/**/*.ts", "src/debug*/**/*.ts"]
}
