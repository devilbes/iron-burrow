{
  "$comment": "Balance simulation spec of GDD 13 §3–4 (bal.sim.*): bot policies, run counts, limits and the bal.sim targets. Thresholds of the metric sims come from docs/plan/QUALITY_TARGETS.json (bot.*).",
  "seeds": [1, 7, 42],
  "runs_per_stage": 10,
  "siege_runs": 20,
  "siege_max_waves": 40,
  "timeout_s": 600,
  "softlock_idle_s": 60,
  "session_s": 720,
  "screens_s": 20,
  "random": { "period_s": 0.25, "fire_p": 0.5 },
  "novice": { "reaction_s": 0.4, "err_p": 0.2, "brick_cost": 3, "powerup_cells": 3 },
  "expert": { "reaction_s": 0.1, "brick_cost": 3, "core_guard_cells": 4, "dodge_cells": 2 },
  "ti_weights": { "grunt": 1.0, "scout": 1.3, "gunner": 1.6, "brute": 2.5 },
  "targets": {
    "bal.sim.novice.win_rate_s01_03": { "min": 80, "max": 95 },
    "bal.sim.novice.win_rate_s04_10": { "min": 65, "max": 90 },
    "bal.sim.novice.win_rate_s11_15": { "min": 50, "max": 70 },
    "bal.sim.novice.win_rate_s16_25": { "min": 35, "max": 65 },
    "bal.sim.novice.win_rate_s26_30": { "min": 30, "max": 50 },
    "bal.sim.novice.stage_duration_median": { "min": 90, "max": 180 },
    "bal.sim.novice.defeat_core_share": { "min": 40, "max": 65 },
    "bal.sim.novice.defeat_lives_share": { "min": 35, "max": 60 },
    "bal.sim.novice.monotonic_violations": { "max": 0 },
    "bal.sim.expert.win_rate_s01_15": { "min": 90 },
    "bal.sim.expert.win_rate_s16_30": { "min": 70 },
    "bal.sim.expert.stage_duration_median": { "min": 70, "max": 150 },
    "bal.sim.random.win_rate_s01_30": { "max": 10 },
    "bal.sim.all.ti_monotonic_violations": { "max": 0 },
    "bal.sim.all.softlocks": { "max": 0 },
    "bal.sim.novice.siege_median_wave": { "min": 4, "max": 8 },
    "bal.sim.expert.siege_median_wave": { "min": 10, "max": 20 },
    "bal.sim.random.siege_median_wave": { "max": 3 },
    "bal.sim.novice.siege_wave_duration_median": { "min": 30, "max": 75 }
  }
}
